# Variables de entorno para Expert Sports Planner
# Copia este archivo como .env.local y completa con valores reales

# ⚠️ IMPORTANTE: .env.local NO debe subirse a Git (está en .gitignore)

# Credenciales del Super Administrador
# Email del administrador principal del sistema
VITE_ADMIN_EMAIL=admin...

# Contraseña del super admin (usar contraseña fuerte, min 20 caracteres)
VITE_ADMIN_PASSWORD=TU_CONTRASEÑA_SEGURA_AQUI

# Nombre mostrado del administrador
VITE_ADMIN_NAME=Administrador

# ========================================
# INSTRUCCIONES DE USO:
# ========================================
# 1. Copiar este archivo: cp .env.example .env.local
# 2. Editar .env.local con las credenciales reales
# 3. Nunca compartir .env.local ni subirlo a Git
# 4. Para producción, configurar estas variables en:
#    - Vercel: Settings > Environment Variables
#    - Netlify: Site settings > Build & deploy > Environment
#    - GitHub Actions: Settings > Secrets and variables
#
# ========================================
# REQUISITOS DE SEGURIDAD:
# ========================================
# La contraseña debe tener:
# - Mínimo 20 caracteres
# - Letras mayúsculas y minúsculas
# - Números
# - Símbolos especiales (!@#$%^&*)
# - No usar palabras comunes del diccionario
